.coverage
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.claude/worktrees/

# === local agent-tool scratch ===
.serena/

# === Python build / packaging artifacts ===
*.egg-info/
*.egg
build/
dist/
MANIFEST

