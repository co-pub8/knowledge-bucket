# === goaldev runtime artifacts ===
.goal_driven_parallel_dev/
docs/MEMO.txt

# === user data directories (managed by kb init in separate repos) ===
# Anchored to the repo root: unanchored `records/` etc. also swallowed the
# examples/demo-bucket fixtures, so CI checkouts lacked the demo bucket.
/records/
/config/
/inbox/
/.kb/

# examples/demo-bucket ships its fixtures (config + docs + registered models),
# but running demo.sh writes regenerable runtime state back into the bucket's
# .kb/ — keep only that remainder ignored.
examples/demo-bucket/.kb/index.db
examples/demo-bucket/.kb/finetune/
examples/demo-bucket/.kb/improve/
examples/demo-bucket/.kb/models/eval/

