# === goaldev runtime artifacts ===
.goal_driven_parallel_dev/
docs/MEMO.txt

# === user data directories (managed by kb init in separate repos) ===
# Anchored to the repo root: unanchored patterns also matched the shipped
# examples/demo-bucket/ content (config/kb.yml, records/doc/*, inbox/) and
# silently kept it out of git, which broke CI on fresh checkouts.
# .kb/ stays unanchored on purpose: it is a runtime cache dir that must
# never be tracked at any depth (PURPOSE.md completion criterion 5).
/records/
/config/
/inbox/
.kb/

# === Python test artifacts ===
.coverage
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.claude/worktrees/

# === local editor / agent tool scratch ===
.serena/

# === Python build / packaging artifacts ===
*.egg-info/
*.egg
build/
dist/
MANIFEST

# === Python virtual environments ===
.venv/
.venv-*/
venv/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
